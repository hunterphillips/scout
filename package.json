{
  "name": "scout-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Scout proof of concept workspace (Phase 2: plumbing + catalog discovery).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/scout-core",
    "packages/native-host",
    "packages/browser-extension",
    "packages/personal-context-mcp"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces && npm run test:spikes && npm run test:scripts",
    "test:spikes": "vitest run --root scripts/spikes",
    "test:scripts": "vitest run --root scripts --exclude 'spikes/**'",
    "test:e2e": "vitest run --root test",
    "test:all": "npm run build && npm test && npm run test:e2e",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "uninstall": "node scripts/uninstall.mjs",
    "preflight:auth": "node scripts/spikes/auth-preflight.mjs",
    "preflight:direct": "node scripts/spikes/direct-profile-preflight.mjs",
    "smoke:agent": "node scripts/spikes/agent-smoke.mjs",
    "spike:capture:prepare": "node scripts/spikes/github-capture/prepare.mjs",
    "spike:bridge:server": "node scripts/spikes/bridge/echo-server.mjs",
    "spike:bridge:echo-test": "node scripts/spikes/bridge/echo-test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/chrome": "^0.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
