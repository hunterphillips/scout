{
  "name": "@scout/native-host",
  "version": "0.0.0",
  "private": true,
  "description": "Chrome native-messaging host for Scout. Chrome runs dist/host.js through the ~/.scout/bin/scout-native-host wrapper.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@scout/contracts": "0.0.0"
  }
}
