{
  "name": "@scout/scout-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Scout's stdio MCP adapter: read-only tools over the core's agent socket. Never starts a core.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "scout-mcp": "dist/main.js"
  },
  "exports": {
    "./main": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./fixture": {
      "types": "./dist/fixture.d.ts",
      "default": "./dist/fixture.js"
    },
    "./testing": {
      "types": "./dist/test-support/fixtureSocket.d.ts",
      "default": "./dist/test-support/fixtureSocket.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@scout/contracts": "0.1.0"
  }
}
