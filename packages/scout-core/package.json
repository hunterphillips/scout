{
  "name": "@scout/scout-core",
  "version": "0.1.0",
  "private": true,
  "description": "Scout coordinator process: visit tracking, activity forwarding, bridge socket, diagnostics.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agents/bridge": {
      "types": "./dist/agents/bridgeMain.d.ts",
      "default": "./dist/agents/bridgeMain.js"
    },
    "./agents/preflight-child": {
      "types": "./dist/agents/preflightChildMain.d.ts",
      "default": "./dist/agents/preflightChildMain.js"
    },
    "./catalog/parse-worker": {
      "types": "./dist/catalog/parseWorkerMain.d.ts",
      "default": "./dist/catalog/parseWorkerMain.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:node": "vitest run --exclude '**/*.mac.test.*'",
    "test:mac": "vitest run --passWithNoTests .mac.test."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@scout/contracts": "0.1.0",
    "@scout/scout-mcp": "0.1.0",
    "fast-xml-parser": "^5.11.1",
    "undici": "^7.30.0",
    "zod": "^4.6.5"
  }
}
